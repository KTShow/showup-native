{
  "appId": "com.showuproom.app",
  "appName": "ShowUp",
  "webDir": "www",
  "server": {
    "url": "https://showuproom.com",
    "cleartext": false
  },
  "ios": {
    "contentInset": "never",
    "appendUserAgent": "ShowUpCover"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
